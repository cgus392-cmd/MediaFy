<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YTDownloader.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título personalizada -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock Text="Introducción" FontSize="12" VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Contenido principal: 2 columnas -->
        <Grid Grid.Row="1" ColumnSpacing="24" Margin="56,12,56,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: texto + acciones -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="18" MaxWidth="440">
                <TextBlock x:Name="TitleText" FontSize="40" FontWeight="SemiBold"
                           TextWrapping="Wrap" LineHeight="46" />
                <TextBlock x:Name="DescText" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <Button x:Name="PrimaryButton" Click="Primary_Click" Margin="0,12,0,0"
                        Style="{ThemeResource AccentButtonStyle}"
                        Padding="22,10" HorizontalAlignment="Left">
                    <TextBlock x:Name="PrimaryButtonText" Text="Comenzar" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- Columna derecha: mockup -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <!-- Estado 1: hero (logo grande) -->
                <Grid x:Name="HeroPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="280" Height="280" CornerRadius="36"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="0.08" />
                    <Border Width="200" Height="200" CornerRadius="28"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="0.12" />
                    <Image Source="ms-appx:///Assets/logo.png" Width="160" Height="160" />
                </Grid>

                <!-- Estado 2: captura tipo "monitor" -->
                <Border x:Name="ShotFrame" Visibility="Collapsed" CornerRadius="14"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="0">
                    <Border.Background>
                        <AcrylicBrush TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                      TintOpacity="0.4" TintLuminosityOpacity="0.85"
                                      FallbackColor="{ThemeResource SolidBackgroundFillColorSecondary}" />
                    </Border.Background>
                    <Image x:Name="ShotImage" Stretch="Uniform" Margin="6"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- Footer: avatar + flechas -->
        <Grid Grid.Row="2" Padding="20,10,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Click="Home_Click" Background="Transparent" BorderThickness="0"
                        Width="36" Height="36" Padding="0"
                        ToolTipService.ToolTip="Ir al inicio del tutorial">
                    <FontIcon Glyph="&#xE80F;" FontSize="14" />
                </Button>
                <Grid Width="36" Height="36">
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="AvatarInitial" Text="?" Foreground="White"
                               FontWeight="SemiBold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="AvatarImageEllipse" Visibility="Collapsed">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AvatarImage" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </StackPanel>

            <!-- Indicadores de paso (puntos) -->
            <ItemsControl x:Name="StepDots" Grid.Column="1" HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button x:Name="PrevBtn" Click="Prev_Click"
                        Background="Transparent" BorderThickness="0"
                        Width="40" Height="40" Padding="0">
                    <FontIcon Glyph="&#xE76B;" FontSize="13" />
                </Button>
                <Button x:Name="NextBtn" Click="Next_Click"
                        Background="Transparent" BorderThickness="0"
                        Width="40" Height="40" Padding="0">
                    <FontIcon Glyph="&#xE76C;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

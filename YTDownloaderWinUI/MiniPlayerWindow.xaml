<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YTDownloader.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">

        <!-- ═══ MODO BARRA ═══ -->
        <Grid x:Name="BarLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="BarDragArea" Padding="12,0,6,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="8" VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon x:Name="MiniIcon" Glyph="&#xEC4F;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Image x:Name="MiniCover" Stretch="UniformToFill" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="MiniTitle" Text="MediaFy" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock x:Name="MiniArtist" Text="Nada en reproducción" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
                <Button Grid.Column="2" Click="Play_Click" Background="Transparent" BorderThickness="0"
                        Width="44" Height="44" Padding="0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Reproducir / pausar">
                    <FontIcon x:Name="MiniPlayIcon" Glyph="&#xE769;" FontSize="18" />
                </Button>
                <Button Grid.Column="3" Click="LayoutCycle_Click" Background="Transparent" BorderThickness="0"
                        Width="34" Height="34" Padding="0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Cambiar forma">
                    <FontIcon Glyph="&#xE740;" FontSize="13" />
                </Button>
                <Button Grid.Column="4" Click="Close_Click" Background="Transparent" BorderThickness="0"
                        Width="34" Height="34" Padding="0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Cerrar">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
            <ProgressBar Grid.Row="1" x:Name="MiniProgress" Minimum="0" Maximum="1000" Value="0" Height="3" />
        </Grid>

        <!-- ═══ MODO CUADRADO ═══ -->
        <Grid x:Name="SquareLayout" Visibility="Collapsed" Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Portada grande (zona arrastrable) -->
            <Border x:Name="SqDragArea" Grid.Row="0" CornerRadius="14"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <Grid>
                    <FontIcon x:Name="SqIcon" Glyph="&#xEC4F;" FontSize="52"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Image x:Name="SqCover" Stretch="UniformToFill" Visibility="Collapsed" />
                    <!-- Cerrar superpuesto -->
                    <Button Click="Close_Click" Background="{ThemeResource SmokeFillColorDefaultBrush}"
                            BorderThickness="0" Width="30" Height="30" Padding="0" CornerRadius="15"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            ToolTipService.ToolTip="Cerrar">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Título / artista -->
            <StackPanel Grid.Row="1" Margin="4,10,4,4">
                <TextBlock x:Name="SqTitle" Text="MediaFy" FontSize="14" FontWeight="SemiBold"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="SqArtist" Text="Nada en reproducción" FontSize="11"
                           TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>

            <!-- Controles + progreso -->
            <StackPanel Grid.Row="2" Spacing="6" Margin="4,2,4,2">
                <ProgressBar x:Name="SqProgress" Minimum="0" Maximum="1000" Value="0" Height="3" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="LayoutCycle_Click" Background="Transparent" BorderThickness="0"
                            Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Cambiar forma">
                        <FontIcon Glyph="&#xE740;" FontSize="13" />
                    </Button>
                    <Button Grid.Column="1" Click="Play_Click" Background="Transparent" BorderThickness="0"
                            Height="40" Padding="0" HorizontalAlignment="Center"
                            ToolTipService.ToolTip="Reproducir / pausar">
                        <FontIcon x:Name="SqPlayIcon" Glyph="&#xE769;" FontSize="22" />
                    </Button>
                    <Border Grid.Column="2" Width="36" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

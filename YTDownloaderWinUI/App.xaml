<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="YTDownloader.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YTDownloader">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters de diagnóstico (globales: usables en flyouts/popups) -->
            <local:HealthGlyphConverter x:Key="HealthGlyph" />
            <local:HealthBrushConverter x:Key="HealthBrush" />
            <local:NotEmptyToVisibleConverter x:Key="NotEmptyVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

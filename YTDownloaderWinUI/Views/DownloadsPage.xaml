<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YTDownloader"
    xmlns:models="using:YTDownloader.Models"
    Background="Transparent">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:StringToBitmapConverter x:Key="StrBmp" />
        <local:StatusToForegroundConverter x:Key="StatusFg" />
        <local:StatusToBackgroundConverter x:Key="StatusBg" />
    </Page.Resources>

    <Grid Margin="28,12,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Descargas" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- URL Input -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE71B;" FontSize="16" Margin="10,0,6,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox Grid.Column="1" x:Name="TxtUrl"
                         PlaceholderText="Pega aquí el enlace de YouTube..."
                         BorderThickness="0" Background="Transparent"
                         FontSize="14" VerticalAlignment="Center"
                         KeyDown="TxtUrl_KeyDown" />
                <Button Grid.Column="2" Click="BtnPaste_Click"
                        Background="Transparent" BorderThickness="0"
                        Width="36" Height="36" Padding="0"
                        ToolTipService.ToolTip="Pegar">
                    <FontIcon Glyph="&#xE77F;" FontSize="15" />
                </Button>
            </Grid>
        </Border>

        <!-- Formato / Calidad / Descargar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="FORMATO" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4" />
                <ComboBox x:Name="CboFormat" Width="120" SelectionChanged="CboFormat_SelectionChanged">
                    <ComboBoxItem Content="MP4" IsSelected="True" />
                    <ComboBoxItem Content="MP3" />
                    <ComboBoxItem Content="M4A" />
                    <ComboBoxItem Content="WEBM" />
                    <ComboBoxItem Content="OGG" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="CALIDAD" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4" />
                <ComboBox x:Name="CboQuality" Width="130">
                    <ComboBoxItem Content="Mejor" IsSelected="True" />
                    <ComboBoxItem Content="4K" />
                    <ComboBoxItem Content="1080p" />
                    <ComboBoxItem Content="720p" />
                    <ComboBoxItem Content="480p" />
                    <ComboBoxItem Content="360p" />
                </ComboBox>
            </StackPanel>

            <Button Grid.Column="4" x:Name="BtnDownload" Click="BtnDownload_Click"
                    Style="{ThemeResource AccentButtonStyle}"
                    MinWidth="150" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock Text="Descargar" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Cabecera lista -->
        <Grid Grid.Row="3" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="En cola" FontSize="16" FontWeight="SemiBold" />
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="10" Padding="9,1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCount" Text="0" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Click="BtnClearDone_Click"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Limpiar completadas" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Vacío -->
            <StackPanel Grid.Row="1" x:Name="EmptyState"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="52"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Sin descargas todavía" FontSize="16" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Text="Pega un enlace de YouTube arriba para comenzar"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- Lista -->
            <ListView Grid.Row="1" x:Name="DownloadsList"
                      SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="64" Height="42" CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource StrBmp}}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock FontSize="12" Margin="0,3,0,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind Format, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind Quality, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind Duration, Mode=OneWay}" />
                                    </TextBlock>
                                    <ProgressBar Margin="0,8,0,0"
                                                 Value="{x:Bind Progress, Mode=OneWay}"
                                                 Minimum="0" Maximum="100"
                                                 Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="20" Padding="14,5"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBg}}">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12"
                                               Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusFg}}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4" Padding="0,10,0,14" Margin="0,12,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Listo" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="yt-dlp + ffmpeg" FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YTDownloader"
    xmlns:models="using:YTDownloader.Models"
    Background="Transparent">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:StringToBitmapConverter x:Key="StrBmp" />
        <local:StatusToForegroundConverter x:Key="StatusFg" />
        <local:StatusToBackgroundConverter x:Key="StatusBg" />
    </Page.Resources>

    <Grid Margin="28,12,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Descargas" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- URL / Búsqueda -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="UrlIcon" Grid.Column="0" Glyph="&#xE71B;" FontSize="16" Margin="10,0,6,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox Grid.Column="1" x:Name="TxtUrl"
                         PlaceholderText="Pega un enlace o escribe para buscar en YouTube..."
                         BorderThickness="0" Background="Transparent"
                         FontSize="14" VerticalAlignment="Center"
                         KeyDown="TxtUrl_KeyDown" TextChanged="TxtUrl_TextChanged" />
                <Button Grid.Column="2" x:Name="BtnClearUrl" Click="BtnClearUrl_Click"
                        Background="Transparent" BorderThickness="0"
                        Width="32" Height="32" Padding="0" Visibility="Collapsed"
                        ToolTipService.ToolTip="Borrar">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
                <Button Grid.Column="3" Click="BtnPaste_Click"
                        Background="Transparent" BorderThickness="0"
                        Width="36" Height="36" Padding="0"
                        ToolTipService.ToolTip="Pegar">
                    <FontIcon Glyph="&#xE77F;" FontSize="15" />
                </Button>
            </Grid>
        </Border>

        <!-- Panel de resultados de búsqueda -->
        <Border Grid.Row="2" x:Name="SearchPanel" Visibility="Collapsed"
                Margin="0,8,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <!-- Cabecera del panel -->
                <Grid Padding="14,10,14,10">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Resultados de YouTube" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressRing x:Name="SearchLoading" Width="18" Height="18"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="SearchEmptyText"
                               Text="Sin resultados" FontSize="12" Visibility="Collapsed"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                <!-- Lista de resultados -->
                <ListView x:Name="SearchResultsList"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="SearchResult_Click"
                          MaxHeight="340">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchResultItem">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Miniatura -->
                                <Border Width="88" Height="50" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind Thumbnail, Converter={StaticResource StrBmp}}" />
                                </Border>
                                <!-- Título + canal + vistas -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Uploader}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Text="{x:Bind Views}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- Reproducir en streaming (no descarga) -->
                                <Button Grid.Column="2" Width="36" Height="36" Padding="0"
                                        VerticalAlignment="Center" CornerRadius="18"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="BtnPlayResult_Click" Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Reproducir en streaming">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                </Button>
                                <!-- Duración -->
                                <Border Grid.Column="3" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind Duration}" FontSize="11" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- ══ Vista previa (Fase 3) ══ -->
        <Border Grid.Row="2" x:Name="PreviewCard" Visibility="Collapsed"
                Margin="0,12,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <!-- Estado: cargando -->
                <StackPanel x:Name="PreviewLoading" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="22" Height="22" />
                    <TextBlock x:Name="PreviewLoadingText" Text="Analizando enlace..." VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Estado: error -->
                <StackPanel x:Name="PreviewError" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xEA39;" FontSize="16"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="PreviewErrorText" Text="No se pudo analizar el enlace"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Estado: info -->
                <Grid x:Name="PreviewInfo" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="128" Height="72" CornerRadius="6" VerticalAlignment="Top"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image x:Name="PreviewThumb" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top">
                        <TextBlock x:Name="PreviewTitle" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE77B;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PreviewUploader" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE916;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PreviewDuration" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="PreviewReadyIcon" Glyph="&#xE73E;" FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock x:Name="PreviewReadyText" Text="Listo para descargar" FontSize="12"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Calidades disponibles como chips -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <TextBlock Text="Calidades:" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ItemsControl x:Name="PreviewQualities">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{x:Bind}" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Formato / Calidad / Subtítulos / Lista / Descargar -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Formato -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="FORMATO" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4" />
                <ComboBox x:Name="CboFormat" Width="120" SelectionChanged="CboFormat_SelectionChanged">
                    <ComboBoxItem Content="MP4" />
                    <ComboBoxItem Content="MKV" />
                    <ComboBoxItem Content="WEBM" />
                    <ComboBoxItem Content="MP3" />
                    <ComboBoxItem Content="M4A" />
                    <ComboBoxItem Content="FLAC" />
                    <ComboBoxItem Content="WAV" />
                    <ComboBoxItem Content="OGG" />
                </ComboBox>
            </StackPanel>

            <!-- Calidad -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="CALIDAD" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4" />
                <ComboBox x:Name="CboQuality" Width="120">
                    <ComboBoxItem Content="Mejor" />
                    <ComboBoxItem Content="4K" />
                    <ComboBoxItem Content="2K" />
                    <ComboBoxItem Content="1080p" />
                    <ComboBoxItem Content="720p" />
                    <ComboBoxItem Content="480p" />
                    <ComboBoxItem Content="360p" />
                    <ComboBoxItem Content="240p" />
                </ComboBox>
            </StackPanel>

            <!-- Subtítulos -->
            <StackPanel Grid.Column="4">
                <TextBlock Text="SUBTÍTULOS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4" />
                <ComboBox x:Name="CboSubtitles" Width="110">
                    <ComboBoxItem Content="Off" />
                    <ComboBoxItem Content="Auto" />
                    <ComboBoxItem Content="ES" />
                    <ComboBoxItem Content="EN" />
                    <ComboBoxItem Content="Todos" />
                </ComboBox>
            </StackPanel>

            <!-- Lista completa -->
            <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <TextBlock Text="LISTA" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4" />
                <ToggleSwitch x:Name="TglPlaylist" IsOn="False"
                              OnContent="Completa" OffContent="1 vídeo"
                              MinWidth="0" />
            </StackPanel>

            <!-- Descargar -->
            <Button Grid.Column="8" x:Name="BtnDownload" Click="BtnDownload_Click"
                    Style="{ThemeResource AccentButtonStyle}"
                    MinWidth="140" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock Text="Descargar" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Cabecera lista -->
        <Grid Grid.Row="4" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="En cola" FontSize="16" FontWeight="SemiBold" />
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="10" Padding="9,1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCount" Text="0" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Click="BtnClearDone_Click"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Limpiar completadas" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Vacío -->
            <StackPanel Grid.Row="1" x:Name="EmptyState"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="52"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Sin descargas todavía" FontSize="16" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Text="Pega un enlace o busca directamente escribiendo arriba"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- Lista -->
            <ListView Grid.Row="1" x:Name="DownloadsList"
                      SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="64" Height="42" CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Stretch="UniformToFill"
                                               Source="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource StrBmp}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind Format, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind Quality, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind Duration, Mode=OneWay}" />
                                        </TextBlock>
                                        <!-- Pista N de M (descargas de lista/álbum) -->
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,5,0,0"
                                                    Visibility="{x:Bind ShowPlaylistInfo, Mode=OneWay, Converter={StaticResource BoolVis}}">
                                            <FontIcon Glyph="&#xE8FD;" FontSize="11"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind PlaylistInfo, Mode=OneWay}" FontSize="11"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <ProgressBar Margin="0,8,0,0"
                                                     Value="{x:Bind Progress, Mode=OneWay}"
                                                     Minimum="0" Maximum="100"
                                                     Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                        <!-- Velocidad · ETA · tamaño -->
                                        <TextBlock Text="{x:Bind DetailLine, Mode=OneWay}"
                                                   FontSize="11" Margin="0,5,0,0"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind ShowDetails, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>

                                    <!-- Badge -->
                                    <Border Grid.Column="2" CornerRadius="20" Padding="14,5"
                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                            Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBg}}">
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusFg}}" />
                                    </Border>

                                    <!-- Acciones -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="BtnCancel_Click" Tag="{x:Bind}"
                                                Background="Transparent" BorderThickness="0"
                                                Width="36" Height="36" Padding="0"
                                                ToolTipService.ToolTip="Cancelar"
                                                Visibility="{x:Bind CanCancel, Mode=OneWay, Converter={StaticResource BoolVis}}">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                        <Button Click="BtnRetry_Click" Tag="{x:Bind}"
                                                Background="Transparent" BorderThickness="0"
                                                Width="36" Height="36" Padding="0"
                                                ToolTipService.ToolTip="Reintentar"
                                                Visibility="{x:Bind CanRetry, Mode=OneWay, Converter={StaticResource BoolVis}}">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Panel de logs (solo si se activa en Configuración) -->
                                <Expander Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent"
                                          Visibility="{x:Bind ShowLogs, Mode=OneWay, Converter={StaticResource BoolVis}}">
                                    <Expander.Header>
                                        <TextBlock Text="Registro" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{x:Bind Logs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" FontSize="11"
                                                               FontFamily="Consolas"
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="5" Padding="0,10,0,14" Margin="0,12,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Listo" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="yt-dlp + ffmpeg" FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>

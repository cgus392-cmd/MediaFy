<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Margin="28,12,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Biblioteca" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE8F1;" FontSize="52"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Próximamente" FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,16,0,6" />
            <TextBlock Text="Aquí verás tus archivos descargados con reproductor integrado"
                       FontSize="13" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YTDownloader"
    xmlns:views="using:YTDownloader.Views"
    xmlns:models="using:YTDownloader.Models"
    Background="Transparent">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:StringToBitmapConverter x:Key="StrBmp" />

        <!-- Plantilla de archivo / pista -->
        <DataTemplate x:Key="FileTpl" x:DataType="models:LibraryFile">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="8" VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="{x:Bind Icon}" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Visibility="{x:Bind ShowIcon, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                            <Image Stretch="UniformToFill"
                                   Source="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource StrBmp}}"
                                   Visibility="{x:Bind ShowCover, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock Text="{x:Bind MetaLine}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BtnPlay_Click" Tag="{x:Bind FullPath}"
                                Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0"
                                ToolTipService.ToolTip="Reproducir">
                            <FontIcon Glyph="&#xE768;" FontSize="16" />
                        </Button>
                        <Button Click="BtnEdit_Click" Tag="{x:Bind FullPath}"
                                Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0"
                                ToolTipService.ToolTip="Editar / recortar">
                            <FontIcon Glyph="&#xE70F;" FontSize="15" />
                        </Button>
                        <Button Click="BtnReveal_Click" Tag="{x:Bind FullPath}"
                                Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0"
                                ToolTipService.ToolTip="Mostrar en el explorador">
                            <FontIcon Glyph="&#xE838;" FontSize="15" />
                        </Button>
                        <Button Click="BtnDelete_Click" Tag="{x:Bind FullPath}"
                                Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0"
                                ToolTipService.ToolTip="Eliminar">
                            <FontIcon Glyph="&#xE74D;" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Plantilla de álbum (carpeta, acordeón) -->
        <DataTemplate x:Key="AlbumTpl" x:DataType="models:LibraryAlbum">
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0">
                <Expander.Header>
                    <Grid Padding="2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/brand/folder_album.png"
                               Width="46" Height="46" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{x:Bind MetaLine}" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Click="BtnOpenMixer_Click" Tag="{x:Bind FolderPath}"
                                    Visibility="{x:Bind IsStemsAlbum, Mode=OneWay, Converter={StaticResource BoolVis}}"
                                    Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0"
                                    Margin="0,0,8,0" ToolTipService.ToolTip="Abrir Mezclador PRO">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                            </Button>
                            <Button Click="BtnRevealFolder_Click" Tag="{x:Bind FolderPath}"
                                    Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0"
                                    ToolTipService.ToolTip="Abrir carpeta del álbum">
                                <FontIcon Glyph="&#xE838;" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{x:Bind Tracks}" ItemTemplate="{StaticResource FileTpl}"
                              Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
        </DataTemplate>

        <views:LibraryItemTemplateSelector x:Key="LibSelector"
            FileTemplate="{StaticResource FileTpl}"
            AlbumTemplate="{StaticResource AlbumTpl}" />
    </Page.Resources>

    <Grid Margin="28,12,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Biblioteca" FontSize="28" FontWeight="SemiBold" />
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="10" Padding="9,1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCount" Text="0" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Tus archivos descargados" FontSize="13" Margin="0,4,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Widget de unidad / disco -->
            <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Margin="24,0,24,0" MaxWidth="340"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,6">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="DriveIcon" Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" MinWidth="150">
                        <TextBlock x:Name="DriveName" Text="Descargas de MediaFy" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <ProgressBar x:Name="DriveBar" Minimum="0" Maximum="1" Value="0" Height="4" />
                        <TextBlock x:Name="DriveSpace" Text="" FontSize="10"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                    <Button x:Name="DriveEject" Grid.Column="2" Click="DriveEject_Click"
                            Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTipService.ToolTip="Expulsar con seguridad">
                        <FontIcon Glyph="&#xE898;" FontSize="14" />
                    </Button>
                    <DropDownButton Grid.Column="3" Padding="6,4" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Cambiar unidad">
                        <FontIcon Glyph="&#xEDA2;" FontSize="14" />
                        <DropDownButton.Flyout>
                            <Flyout x:Name="DriveFlyout" Opening="DriveFlyout_Opening">
                                <ListView x:Name="DriveList" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="DriveList_ItemClick" MaxHeight="320" MinWidth="260">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:StorageDrive">
                                            <Grid ColumnSpacing="10" Padding="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Icon}" FontSize="18" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{x:Bind TypeLabel}" /><Run Text="  ·  " /><Run Text="{x:Bind SpaceText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="BtnOpenFolder_Click" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Abrir carpeta">
                    <FontIcon Glyph="&#xE838;" FontSize="15" />
                </Button>
                <Button Click="BtnRefresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Actualizar" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Vacío -->
        <StackPanel Grid.Row="1" x:Name="EmptyState"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE8F1;" FontSize="52"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Biblioteca vacía" FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,16,0,6" />
            <TextBlock Text="Los archivos que descargues aparecerán aquí"
                       FontSize="13" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- Lista (álbumes + archivos) -->
        <ListView Grid.Row="1" x:Name="FilesList" SelectionMode="None" Visibility="Collapsed"
                  ItemTemplateSelector="{StaticResource LibSelector}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>

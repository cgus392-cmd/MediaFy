<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" MaxWidth="780" Margin="28,40,28,28" Spacing="6">

            <!-- Logo grande -->
            <Image Source="ms-appx:///Assets/logo.png" Width="104" Height="104"
                   HorizontalAlignment="Center" />

            <TextBlock Text="Bienvenido a MediaFy" FontSize="30" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock HorizontalAlignment="Center" FontSize="14" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Tu gestor de descargas multiplataforma. ¿Qué quieres hacer hoy?" />

            <!-- Accesos rápidos -->
            <Grid Margin="0,28,0,0" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Click="Go_Downloads" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="18" Style="{ThemeResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE896;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Descargas" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Pega un enlace y descárgalo" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="1" Click="Go_Cascade" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="18" Style="{ThemeResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xEC4A;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Descargas en cascada" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Varias en escalonado, sin saturar" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="0" Click="Go_Library" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="18" Style="{ThemeResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE8F1;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Biblioteca" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Tus archivos descargados" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="1" Click="Go_Editor" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="18" Style="{ThemeResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE714;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Editor" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Reproduce y recorta con forma de onda" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Estado del sistema (mismo dato que el semáforo de la barra superior) -->
            <Border Margin="0,14,0,0" Padding="16" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <FontIcon x:Name="HealthCardIcon" Glyph="&#xEC61;" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Estado del sistema" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock x:Name="HealthCardSummary" Text="Comprobando…" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="HealthCard_Recheck" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Comprobar ahora (incluye la prueba real de YouTube)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Comprobar" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Text="MediaFy by CG  ·  CG LABS" FontSize="12" Margin="0,28,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:YTDownloader.Core"
    Background="Transparent">
    <Grid Margin="28,12,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuración" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Spacing="12">

            <!-- Apariencia (telón de fondo) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE771;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Telón de fondo" FontWeight="SemiBold" />
                        <TextBlock Text="Material translúcido de toda la ventana"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="CboBackdrop" Width="170"
                              VerticalAlignment="Center" SelectionChanged="OnBackdropChanged">
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                        <ComboBoxItem Content="Acrílico" Tag="Acrylic" />
                        <ComboBoxItem Content="Acrílico fino" Tag="AcrylicThin" />
                        <ComboBoxItem Content="Ninguno" Tag="None" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Carpeta -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Carpeta de descargas" FontWeight="SemiBold" />
                            <TextBlock Text="Dónde se guardan los archivos" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFolder" IsReadOnly="True" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Cambiar" Click="OnBrowse" />
                    </Grid>
                </Grid>
            </Border>

            <!-- yt-dlp -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="yt-dlp" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtYtDlpVersion" Text="Comprobando versión..." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Actualizar" Click="OnUpdateYtDlp" />
                </Grid>
            </Border>

            <!-- Mostrar registro -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Mostrar registro de descargas" FontWeight="SemiBold" />
                        <TextBlock Text="Añade un panel desplegable con la salida técnica de cada descarga"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                  IsOn="{x:Bind core:AppSettings.Current.ShowLogs, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Umbral de cascada -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEC4A;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Umbral de cascada" FontWeight="SemiBold" />
                        <TextBlock Text="% de progreso al que arranca la siguiente descarga en cascada"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="CboThreshold" Width="90"
                              VerticalAlignment="Center" SelectionChanged="OnThresholdChanged">
                        <ComboBoxItem Content="50%" Tag="50" />
                        <ComboBoxItem Content="60%" Tag="60" />
                        <ComboBoxItem Content="70%" Tag="70" />
                        <ComboBoxItem Content="80%" Tag="80" />
                        <ComboBoxItem Content="90%" Tag="90" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Reproductor -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE768;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Reproductor" FontWeight="SemiBold" />
                        <TextBlock Text="Con qué reproducir los archivos de la Biblioteca"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="CboPlayer" Width="180"
                              VerticalAlignment="Center" SelectionChanged="OnPlayerChanged">
                        <ComboBoxItem Content="Preguntar cada vez" Tag="Ask" />
                        <ComboBoxItem Content="Reproductor integrado" Tag="Integrated" />
                        <ComboBoxItem Content="Otro programa" Tag="System" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Guardado de corte -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C6;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Guardado de cortes" FontWeight="SemiBold" />
                        <TextBlock Text="Qué hacer al recortar un fragmento en el Editor"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="CboCut" Width="180"
                              VerticalAlignment="Center" SelectionChanged="OnCutChanged">
                        <ComboBoxItem Content="Preguntar cada vez" Tag="Ask" />
                        <ComboBoxItem Content="Crear copia nueva" Tag="NewCopy" />
                        <ComboBoxItem Content="Reemplazar original" Tag="Replace" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Info tema -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Tema y color" FontWeight="SemiBold" />
                        <TextBlock Text="La app sigue automáticamente el tema y color de acento de Windows"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>

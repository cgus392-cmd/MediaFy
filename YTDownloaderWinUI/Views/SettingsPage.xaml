<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:YTDownloader.Core"
    xmlns:models="using:YTDownloader.Models"
    Background="Transparent">
    <Grid Margin="28,12,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuración" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Spacing="12" Padding="0,0,0,20">

            <!-- Apariencia (telón de fondo) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE771;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Telón de fondo" FontWeight="SemiBold" />
                        <TextBlock Text="Material translúcido de toda la ventana"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="CboBackdrop" Width="170"
                              VerticalAlignment="Center" SelectionChanged="OnBackdropChanged">
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                        <ComboBoxItem Content="Acrílico" Tag="Acrylic" />
                        <ComboBoxItem Content="Acrílico fino" Tag="AcrylicThin" />
                        <ComboBoxItem Content="Ninguno" Tag="None" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Carpeta -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Carpeta de descargas" FontWeight="SemiBold" />
                            <TextBlock Text="Dónde se guardan los archivos" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFolder" IsReadOnly="True" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Cambiar" Click="OnBrowse" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Preferencias de descarga -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9F5;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Preferencias de descarga" FontWeight="SemiBold" />
                            <TextBlock Text="Formato, calidad y subtítulos que se usan por defecto"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Formato" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox x:Name="CboDlFormat" HorizontalAlignment="Stretch"
                                      SelectionChanged="CboDlFormat_SelectionChanged">
                                <ComboBoxItem Content="MP4" />
                                <ComboBoxItem Content="MKV" />
                                <ComboBoxItem Content="WEBM" />
                                <ComboBoxItem Content="MP3" />
                                <ComboBoxItem Content="M4A" />
                                <ComboBoxItem Content="FLAC" />
                                <ComboBoxItem Content="WAV" />
                                <ComboBoxItem Content="OGG" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Calidad (vídeo)" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox x:Name="CboDlQuality" HorizontalAlignment="Stretch"
                                      SelectionChanged="CboDlQuality_SelectionChanged">
                                <ComboBoxItem Content="Mejor" />
                                <ComboBoxItem Content="4K" />
                                <ComboBoxItem Content="2K" />
                                <ComboBoxItem Content="1080p" />
                                <ComboBoxItem Content="720p" />
                                <ComboBoxItem Content="480p" />
                                <ComboBoxItem Content="360p" />
                                <ComboBoxItem Content="240p" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Subtítulos" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox x:Name="CboDlSubtitles" HorizontalAlignment="Stretch"
                                      SelectionChanged="CboDlSubtitles_SelectionChanged">
                                <ComboBoxItem Content="Off" />
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="ES" />
                                <ComboBoxItem Content="EN" />
                                <ComboBoxItem Content="Todos" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               Text="Estos valores pre-rellenan las páginas de Descargas y Cascada. Puedes cambiarlos por descarga individualmente." />

                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2,0,2" />

                    <!-- Carpeta por álbum/lista -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Crear carpeta por álbum o lista" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Al descargar una lista completa, agrupa las pistas en una carpeta con el nombre de la lista y las numera (01 -, 02 -…)." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="TogPlaylistFolder"
                                      Toggled="TogPlaylistFolder_Toggled" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- yt-dlp -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="yt-dlp" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtYtDlpVersion" Text="Comprobando versión..." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Actualizar" Click="OnUpdateYtDlp" />
                </Grid>
            </Border>

            <!-- Portadas en la biblioteca -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B9;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Portadas en la biblioteca" FontWeight="SemiBold" />
                        <TextBlock Text="Mostrar la portada de cada archivo (activado) o el icono del formato (desactivado)"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                  IsOn="{x:Bind core:AppSettings.Current.LibraryShowCovers, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Mostrar registro -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Mostrar registro de descargas" FontWeight="SemiBold" />
                        <TextBlock Text="Añade un panel desplegable con la salida técnica de cada descarga"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                  IsOn="{x:Bind core:AppSettings.Current.ShowLogs, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Umbral de cascada -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEC4A;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Umbral de cascada" FontWeight="SemiBold" />
                        <TextBlock Text="% de progreso al que arranca la siguiente descarga en cascada"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="CboThreshold" Width="90"
                              VerticalAlignment="Center" SelectionChanged="OnThresholdChanged">
                        <ComboBoxItem Content="50%" Tag="50" />
                        <ComboBoxItem Content="60%" Tag="60" />
                        <ComboBoxItem Content="70%" Tag="70" />
                        <ComboBoxItem Content="80%" Tag="80" />
                        <ComboBoxItem Content="90%" Tag="90" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Reproductor -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE768;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Reproductor" FontWeight="SemiBold" />
                        <TextBlock Text="Con qué reproducir los archivos de la Biblioteca"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="CboPlayer" Width="180"
                              VerticalAlignment="Center" SelectionChanged="OnPlayerChanged">
                        <ComboBoxItem Content="Preguntar cada vez" Tag="Ask" />
                        <ComboBoxItem Content="Reproductor integrado" Tag="Integrated" />
                        <ComboBoxItem Content="Otro programa" Tag="System" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Guardado de corte -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C6;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Guardado de cortes" FontWeight="SemiBold" />
                        <TextBlock Text="Qué hacer al recortar un fragmento en el Editor"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="CboCut" Width="180"
                              VerticalAlignment="Center" SelectionChanged="OnCutChanged">
                        <ComboBoxItem Content="Preguntar cada vez" Tag="Ask" />
                        <ComboBoxItem Content="Crear copia nueva" Tag="NewCopy" />
                        <ComboBoxItem Content="Reemplazar original" Tag="Replace" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Info tema -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Tema y color" FontWeight="SemiBold" />
                        <TextBlock Text="La app sigue automáticamente el tema y color de acento de Windows"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ Actualizaciones ══ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE777;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Actualizaciones de MediaFy" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateStatusText" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="BtnCheckUpdate" Click="OnCheckUpdate" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="Buscar" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Minimum="0" Maximum="100" />
                    <StackPanel x:Name="UpdateActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Button x:Name="BtnDownloadUpdate" Click="OnDownloadUpdate"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock x:Name="BtnDownloadText" Text="Descargar e instalar" />
                            </StackPanel>
                        </Button>
                        <HyperlinkButton x:Name="LinkReleaseNotes" Content="Ver notas de la versión" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Buscar al iniciar" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="MediaFy comprueba si hay una versión nueva cada vez que arrancas."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                                      IsOn="{x:Bind core:AppSettings.Current.AutoCheckUpdates, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Integración con Windows ══ -->
            <TextBlock Text="Integración con Windows" FontSize="18" FontWeight="SemiBold" Margin="2,10,0,0" />
            <TextBlock Text="Cómo MediaFy se comporta como una app del sistema."
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,-6,0,2" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA8F;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Notificar al terminar descargas" FontWeight="SemiBold" />
                        <TextBlock Text="Recibe una notificación nativa de Windows con botones para abrir el archivo o mostrarlo en la carpeta."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                  IsOn="{x:Bind core:AppSettings.Current.NotifyOnComplete, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7E8;" FontSize="18" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Iniciar con Windows" FontWeight="SemiBold" />
                        <TextBlock Text="MediaFy arranca al encender el equipo y queda esperando en la bandeja del sistema, sin abrir ventana."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="TogStartup" VerticalAlignment="Center" MinWidth="0"
                                  Toggled="OnStartupToggled" />
                </Grid>
            </Border>

            <!-- ══ Conexión externa ══ -->
            <TextBlock Text="Conexión externa" FontSize="18" FontWeight="SemiBold" Margin="2,10,0,0" />
            <TextBlock Text="Cómo se comunica MediaFy con el resto del sistema y de la web."
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,-6,0,2" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72C;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Actualizar yt-dlp automáticamente" FontWeight="SemiBold" />
                        <TextBlock Text="Al iniciar MediaFy, busca y aplica actualizaciones del motor de descarga (recomendado: YouTube cambia seguido)."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                  IsOn="{x:Bind core:AppSettings.Current.AutoUpdateYtDlp, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE71B;" FontSize="18" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Protocolo mediafy://" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Permite que enlaces del tipo mediafy://download?url=... (desde la extensión de navegador o cualquier app) abran MediaFy y carguen el enlace listo para descargar." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="TogProtocol" VerticalAlignment="Center" MinWidth="0"
                                  Toggled="OnProtocolToggled" />
                </Grid>
            </Border>

            <!-- Vigilar portapapeles -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xF0E3;" FontSize="18" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Vigilar el portapapeles" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Cuando copies un enlace soportado (YouTube, Spotify, SoundCloud, etc.), MediaFy mostrará una pequeña sugerencia para descargarlo." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                  IsOn="{x:Bind core:AppSettings.Current.ClipboardWatch, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Extensión de navegador -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="18" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Extensión de navegador" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Añade un botón 'Descargar con MediaFy' a YouTube, Spotify, TikTok y muchos más. Pulsa Instalar para abrir un asistente guiado paso a paso." />
                    </StackPanel>
                    <Button Grid.Column="2" Click="OnInstallExtension" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="Instalar" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ══ Cuenta de YouTube (autenticación) ══ -->
            <TextBlock Text="Cuenta de YouTube" FontSize="18" FontWeight="SemiBold" Margin="2,10,0,0" />
            <TextBlock Text="Desde 2025, YouTube exige una sesión iniciada para descargar o reproducir la mayoría de videos. Importa un cookies.txt de tu navegador (con sesión de YouTube) para autenticar MediaFy."
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,-6,0,2" />

            <!-- Cookies de sesión -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="18" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cookies de sesión (cookies.txt)" FontWeight="SemiBold" />
                        <TextBlock x:Name="CookiesStatus" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Sin configurar." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="BtnClearCookies" Click="OnClearCookies"
                                ToolTipService.ToolTip="Quitar cookies" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        </Button>
                        <Button Click="OnImportCookies" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                <TextBlock Text="Importar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estado del runtime JS (Node) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE943;" FontSize="18" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Motor de YouTube (incluido)" FontWeight="SemiBold" />
                        <TextBlock x:Name="NodeStatus" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Comprobando…" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cómo exportar cookies -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE897;" FontSize="15" />
                        <TextBlock Text="¿Cómo exporto mi cookies.txt?" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="6" Padding="4,4,4,8">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="1. Instala la extensión &quot;Get cookies.txt LOCALLY&quot; en tu navegador (es open-source y no envía tus datos)." />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="2. Abre youtube.com con tu cuenta iniciada." />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="3. Pulsa el ícono de la extensión → Export. Se descarga un cookies.txt." />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="4. Pulsa &quot;Importar&quot; aquí y selecciona ese archivo. Las cookies se guardan solo en tu equipo." />
                </StackPanel>
            </Expander>

            <!-- ══ Plataformas ══ -->
            <TextBlock Text="Plataformas" FontSize="18" FontWeight="SemiBold" Margin="2,10,0,0" />
            <TextBlock Text="Activa las fuentes desde las que quieres descargar. Cada una se habilita con su interruptor."
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,-6,0,2" />
            <ItemsControl x:Name="PlatformsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PlatformOption">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                              IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Info Spotify -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xEC4F;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel>
                        <TextBlock Text="Spotify" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="No requiere cuenta, credenciales ni Premium. Activa Spotify arriba, pega un enlace de canción, álbum o playlist en Descargas, y la app obtiene los datos públicos y descarga el audio equivalente desde YouTube etiquetado." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

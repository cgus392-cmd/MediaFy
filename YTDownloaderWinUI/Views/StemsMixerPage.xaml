<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.StemsMixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YTDownloader.Views.Controls"
    Background="Transparent">

    <Grid Margin="28,12,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Margin="0,0,16,0" VerticalAlignment="Center" ToolTipService.ToolTip="Volver a la Biblioteca">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="Mezclador de Stems" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtSubtitle" Text="Ajusta el volumen, silencia o aísla pistas" FontSize="13" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="2" Click="BtnExport_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE78C;" FontSize="14" />
                    <TextBlock Text="Exportar mezcla" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Pistas -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TracksPanel" Spacing="0" Padding="0,0,12,20">
                <!-- Los StemTrackControl se agregarán aquí dinámicamente -->
            </StackPanel>
        </ScrollViewer>

        <!-- Controles Maestros (Abajo) -->
        <Border Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="24,16" Margin="-28,0,-28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPlayPause" Click="BtnPlayPause_Click" Background="Transparent" BorderThickness="0" Width="48" Height="48" CornerRadius="24">
                    <FontIcon x:Name="IconPlayPause" Glyph="&#xE768;" FontSize="20" />
                </Button>

                <Slider Grid.Column="1" x:Name="SldPosition" Margin="24,0" VerticalAlignment="Center"
                        ValueChanged="SldPosition_ValueChanged" />

                <TextBlock Grid.Column="2" x:Name="TxtTime" Text="00:00 / 00:00" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
        
        <!-- Overlay de carga inicial -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#AA000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" />
                <TextBlock Text="Cargando motor de audio y formas de onda..." FontSize="16" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

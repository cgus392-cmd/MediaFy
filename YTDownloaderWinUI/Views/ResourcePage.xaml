<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.ResourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,12,28,28" Spacing="14">
            <TextBlock Text="Monitor de recursos" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Uso del sistema en tiempo real" FontSize="13" Margin="0,-8,0,4"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- ══ CPU ══ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="#2BC4C4" />
                        <TextBlock Text="CPU" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                    <Grid x:Name="CpuGraph" Height="120" SizeChanged="Graph_SizeChanged">
                        <Border CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                        <Polygon x:Name="CpuFill" Fill="#332BC4C4" />
                        <Polyline x:Name="CpuLine" Stroke="#2BC4C4" StrokeThickness="2"
                                  StrokeLineJoin="Round" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Utilización" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="CpuPct" Text="—" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Procesos" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="CpuProcs" Text="—" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Memoria ══ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEEA0;" FontSize="16" Foreground="#4C8BF5" />
                        <TextBlock Text="Memoria" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                    <Grid x:Name="MemGraph" Height="120" SizeChanged="Graph_SizeChanged">
                        <Border CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                        <Polygon x:Name="MemFill" Fill="#334C8BF5" />
                        <Polyline x:Name="MemLine" Stroke="#4C8BF5" StrokeThickness="2"
                                  StrokeLineJoin="Round" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="En uso" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="MemUsed" Text="—" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Total" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="MemTotal" Text="—" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Red ══ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="#E0529C" />
                        <TextBlock Text="Red" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                    <Grid x:Name="NetGraph" Height="120" SizeChanged="Graph_SizeChanged">
                        <Border CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                        <Polygon x:Name="NetFill" Fill="#33E0529C" />
                        <Polyline x:Name="NetLine" Stroke="#E0529C" StrokeThickness="2"
                                  StrokeLineJoin="Round" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Enviar" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="NetSend" Text="—" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Recibir" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="NetRecv" Text="—" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

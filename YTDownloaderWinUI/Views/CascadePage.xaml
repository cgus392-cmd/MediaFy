<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.CascadePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YTDownloader"
    xmlns:models="using:YTDownloader.Models"
    Background="Transparent">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:StringToBitmapConverter x:Key="StrBmp" />
        <local:StatusToForegroundConverter x:Key="StatusFg" />
        <local:StatusToBackgroundConverter x:Key="StatusBg" />
    </Page.Resources>

    <Grid Margin="28,12,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: título -->
            <RowDefinition Height="Auto" />   <!-- 1: formato/calidad/subs -->
            <RowDefinition Height="Auto" />   <!-- 2: input URL -->
            <RowDefinition Height="Auto" />   <!-- 3: panel búsqueda (Collapsed si no aplica) -->
            <RowDefinition Height="Auto" />   <!-- 4: barra de acciones -->
            <RowDefinition Height="*"    />   <!-- 5: lista de ítems -->
            <RowDefinition Height="Auto" />   <!-- 6: footer -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Descargas en cascada" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Agrega hasta 5 enlaces. Cada descarga arranca cuando la anterior alcanza el umbral configurado — suave y sin saturar la red."
                       FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Formato / Calidad / Subtítulos -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Formato -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="FORMATO" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4" />
                <ComboBox x:Name="CboFormat" Width="120" SelectionChanged="CboFormat_SelectionChanged">
                    <ComboBoxItem Content="MP4" />
                    <ComboBoxItem Content="MKV" />
                    <ComboBoxItem Content="WEBM" />
                    <ComboBoxItem Content="MP3" />
                    <ComboBoxItem Content="M4A" />
                    <ComboBoxItem Content="FLAC" />
                    <ComboBoxItem Content="WAV" />
                    <ComboBoxItem Content="OGG" />
                </ComboBox>
            </StackPanel>

            <!-- Calidad -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="CALIDAD" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4" />
                <ComboBox x:Name="CboQuality" Width="120">
                    <ComboBoxItem Content="Mejor" />
                    <ComboBoxItem Content="4K" />
                    <ComboBoxItem Content="2K" />
                    <ComboBoxItem Content="1080p" />
                    <ComboBoxItem Content="720p" />
                    <ComboBoxItem Content="480p" />
                    <ComboBoxItem Content="360p" />
                    <ComboBoxItem Content="240p" />
                </ComboBox>
            </StackPanel>

            <!-- Subtítulos -->
            <StackPanel Grid.Column="4">
                <TextBlock Text="SUBTÍTULOS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4" />
                <ComboBox x:Name="CboSubtitles" Width="110">
                    <ComboBoxItem Content="Off" />
                    <ComboBoxItem Content="Auto" />
                    <ComboBoxItem Content="ES" />
                    <ComboBoxItem Content="EN" />
                    <ComboBoxItem Content="Todos" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Input para agregar (con búsqueda integrada) -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="UrlIcon" Grid.Column="0" Glyph="&#xE71B;" FontSize="16" Margin="10,0,6,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox Grid.Column="1" x:Name="TxtUrl"
                         PlaceholderText="Pega un enlace o escribe para buscar en YouTube..."
                         BorderThickness="0" Background="Transparent"
                         FontSize="14" VerticalAlignment="Center"
                         KeyDown="TxtUrl_KeyDown" TextChanged="TxtUrl_TextChanged" />
                <Button Grid.Column="2" x:Name="BtnClearUrl" Click="BtnClearUrl_Click"
                        Background="Transparent" BorderThickness="0"
                        Width="32" Height="32" Padding="0" Visibility="Collapsed"
                        ToolTipService.ToolTip="Borrar">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
                <Button Grid.Column="3" x:Name="BtnAdd" Click="BtnAdd_Click"
                        Style="{ThemeResource AccentButtonStyle}" Margin="4"
                        Content="Agregar" />
            </Grid>
        </Border>

        <!-- Panel de resultados de búsqueda (YouTube) -->
        <Border Grid.Row="3" x:Name="SearchPanel" Visibility="Collapsed"
                Margin="0,8,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <Grid Padding="14,10,14,10">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Resultados de YouTube" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CascadeSearchHint" FontSize="12" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="— Haz clic en un resultado y pulsa Agregar" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressRing x:Name="SearchLoading" Width="18" Height="18"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="SearchEmptyText" Text="Sin resultados" FontSize="12"
                               Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                <ListView x:Name="SearchResultsList"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="SearchResult_Click"
                          MaxHeight="300">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchResultItem">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="88" Height="50" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind Thumbnail, Converter={StaticResource StrBmp}}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Uploader}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Text="{x:Bind Views}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind Duration}" FontSize="11" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Barra de acciones -->
        <Grid Grid.Row="4" Margin="2,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Lista" FontSize="16" FontWeight="SemiBold" />
                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="10" Padding="9,1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCount" Text="0 / 5" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnAnalyze" Click="BtnAnalyze_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="Analizar todo" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnStart" Click="BtnStart_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEC4A;" FontSize="14" />
                        <TextBlock Text="Iniciar cascada" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Lista de ítems -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xEC4A;" FontSize="52"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Lista vacía" FontSize="16" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Text="Agrega enlaces arriba, pulsa Analizar todo y luego Iniciar cascada"
                           FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <ListView x:Name="ItemsList" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="64" Height="42" CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource StrBmp}}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock FontSize="12" Margin="0,3,0,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind Format, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind Quality, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind Duration, Mode=OneWay}" />
                                    </TextBlock>
                                    <ProgressBar Margin="0,8,0,0"
                                                 Value="{x:Bind Progress, Mode=OneWay}"
                                                 Minimum="0" Maximum="100"
                                                 Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="{x:Bind DetailLine, Mode=OneWay}"
                                               FontSize="11" Margin="0,5,0,0"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind ShowDetails, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="20" Padding="14,5"
                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                        Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBg}}">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12"
                                               Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusFg}}" />
                                </Border>

                                <Button Grid.Column="3" Click="BtnRemove_Click" Tag="{x:Bind}"
                                        Background="Transparent" BorderThickness="0"
                                        Width="36" Height="36" Padding="0"
                                        ToolTipService.ToolTip="Quitar de la lista">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="6" Padding="0,10,0,14" Margin="0,12,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="TxtStatus" Text="Listo" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Page>

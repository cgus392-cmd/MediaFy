<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YTDownloader.Views.Controls.StemTrackControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Izquierda: Nombre y volumen -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="TxtName" Text="Track Name" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Grid.Column="1" x:Name="SldVolume" Minimum="0" Maximum="1" Value="1" StepFrequency="0.01" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldVolume_ValueChanged" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <ToggleButton x:Name="BtnMute" Width="50" Content="M" ToolTipService.ToolTip="Mute (Silenciar)" Checked="BtnMute_CheckedChanged" Unchecked="BtnMute_CheckedChanged" />
                    <ToggleButton x:Name="BtnSolo" Width="50" Content="S" ToolTipService.ToolTip="Solo (Aislar)" Checked="BtnSolo_CheckedChanged" Unchecked="BtnSolo_CheckedChanged" />
                </StackPanel>
            </StackPanel>

            <!-- Centro: Forma de onda -->
            <Border Grid.Column="1" Background="#11FFFFFF" CornerRadius="6">
                <Grid>
                    <Image x:Name="ImgWaveform" Stretch="Fill" Height="60" />
                    
                    <!-- Indicador de carga -->
                    <ProgressRing x:Name="RingLoading" IsActive="False" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YTDownloader.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" MaxWidth="720" Margin="28,40,28,28" Spacing="14">

            <!-- Encabezado -->
            <Image Source="ms-appx:///Assets/logo.png" Width="96" Height="96" HorizontalAlignment="Center" />
            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold">
                    <Run Text="MediaFy" />
                    <Run Text="by CG" FontSize="15" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10"
                        Padding="10,2" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="Versión 1.0.0" FontSize="12" Foreground="White" />
                </Border>
            </StackPanel>

            <!-- Descripción -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="Acerca del proyecto" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="MediaFy es un gestor de descargas multiplataforma para Windows: descarga vídeo y audio de YouTube, SoundCloud, TikTok, Spotify y cientos de sitios más, con vista previa, descargas en cascada, biblioteca con reproductor integrado y editor con forma de onda. Diseñado de forma nativa con WinUI 3, siguiendo el lenguaje visual Fluent de Windows 11." />
                </StackPanel>
            </Border>

            <!-- Datos -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
                <StackPanel>
                    <Grid Padding="14,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE787;" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Fecha de creación" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Mayo de 2026" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Padding="14,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE821;" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desarrollado por" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="CG LABS" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Padding="14,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77B;" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Responsable" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="CG (Camilo G.)" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Enlaces -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="Enlaces" FontWeight="SemiBold" Margin="4,0,0,4" />
                    <HyperlinkButton x:Name="LinkGitHub" Content="GitHub del desarrollador — github.com/cgus392-cmd"
                                     NavigateUri="https://github.com/cgus392-cmd" />
                    <HyperlinkButton Content="Contacto: cgus392@gmail.com"
                                     NavigateUri="mailto:cgus392@gmail.com" />
                </StackPanel>
            </Border>

            <!-- Ver introducción otra vez -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Introducción a MediaFy" FontWeight="SemiBold" />
                        <TextBlock Text="Vuelve a ver el tutorial guiado paso a paso."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="BtnShowTutorial_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                            <TextBlock Text="Ver introducción" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock TextAlignment="Center" FontSize="11" Margin="0,4,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="Construido con WinUI 3 · Windows App SDK · yt-dlp · ffmpeg" />
            <TextBlock Text="© 2026 CG LABS" TextAlignment="Center" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>

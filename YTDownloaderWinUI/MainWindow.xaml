<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YTDownloader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YTDownloader"
    xmlns:core="using:YTDownloader.Core"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolVis" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0" Spacing="10">
                <Image Source="ms-appx:///Assets/logo.png" Width="20" Height="20" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="MediaFy" FontWeight="SemiBold" FontSize="13" />
                    <Run Text="by CG" FontSize="11"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </TextBlock>
            </StackPanel>

            <!-- Semáforo de estado del sistema -->
            <Button x:Name="BtnHealth" HorizontalAlignment="Right" Margin="0,0,186,0"
                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                    Width="40" Height="32" Padding="0" ToolTipService.ToolTip="Estado del sistema">
                <FontIcon x:Name="HealthIcon" Glyph="&#xEC61;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button.Flyout>
                    <Flyout Placement="Bottom" Opened="Health_FlyoutOpened">
                        <Grid Width="360" MaxHeight="500" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Estado del sistema" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock x:Name="HealthSummary" Text="" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Health_Recheck_Click"
                                        ToolTipService.ToolTip="Comprobar ahora (incluye la prueba real de YouTube)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock Text="Comprobar" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ListView Grid.Row="1" x:Name="HealthList" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="6,6" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:HealthCheck">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{Binding Status, Converter={StaticResource HealthGlyph}}"
                                                      Foreground="{Binding Status, Converter={StaticResource HealthBrush}}"
                                                      FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding ActionLabel}" Tag="{Binding}"
                                                    Click="Health_Action_Click" VerticalAlignment="Center" FontSize="12"
                                                    Visibility="{Binding ActionLabel, Converter={StaticResource NotEmptyVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Centro de notificaciones -->
            <Button x:Name="BtnNotifications" HorizontalAlignment="Right" Margin="0,0,146,0"
                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                    Width="40" Height="32" Padding="0" ToolTipService.ToolTip="Notificaciones">
                <Grid>
                    <FontIcon Glyph="&#xE7E7;" FontSize="16" />
                    <muxc:InfoBadge x:Name="NotifBadge" Value="0" Visibility="Collapsed"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-2,-4,0" />
                </Grid>
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="320" Spacing="8">
                            <Grid>
                                <TextBlock Text="Notificaciones" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="Limpiar" Click="Notif_Clear_Click" HorizontalAlignment="Right"
                                        Background="Transparent" BorderThickness="0" Padding="8,2" FontSize="12" />
                            </Grid>
                            <TextBlock x:Name="NotifEmpty" Text="Sin notificaciones" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl x:Name="NotifList" MaxHeight="360">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{Binding Glyph}" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <TextBlock Text="{Binding Status, Mode=OneWay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                                             IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                             Minimum="0" Maximum="100" Height="3" Margin="0,2,0,0"
                                                             Visibility="{Binding BarVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Navegación lateral -->
        <muxc:NavigationView x:Name="Nav" Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="True"
                             PaneDisplayMode="Left"
                             OpenPaneLength="220"
                             SelectionChanged="Nav_SelectionChanged">

            <!-- Cuadrito compacto (fuera de Biblioteca) -->
            <muxc:NavigationView.PaneFooter>
                <Border x:Name="MiniPlayer" Visibility="Collapsed"
                        Margin="8,4,8,8" Padding="0" CornerRadius="16" BorderThickness="0">
                    <Border.Background>
                        <!-- Vidrio translúcido de reserva (cuando la canción no tiene carátula). -->
                        <AcrylicBrush TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                      TintOpacity="0.10" TintLuminosityOpacity="0.42"
                                      FallbackColor="#59FFFFFF" />
                    </Border.Background>
                    <Grid>
                        <!-- Carátula del álbum al fondo; el acrílico de arriba la difumina (frosted glass). -->
                        <Image x:Name="MiniCardCover" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="MiniCoverFrost" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Background>
                                <AcrylicBrush TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                              TintOpacity="0.35" TintLuminosityOpacity="0.62"
                                              FallbackColor="#88FFFFFF" />
                            </Border.Background>
                        </Border>
                        <!-- Sheen: brillo diagonal (arriba-izquierda) que da el reflejo de cristal -->
                        <Border CornerRadius="16" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                                    <GradientStop Color="#38FFFFFF" Offset="0" />
                                    <GradientStop Color="#0EFFFFFF" Offset="0.38" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.72" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- Borde de vidrio: brillo arriba, sombra sutil abajo (da relieve) -->
                        <Border CornerRadius="16" BorderThickness="1" IsHitTestVisible="False">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#78FFFFFF" Offset="0" />
                                    <GradientStop Color="#18FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#28000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>

                        <StackPanel Spacing="9" Margin="12,11">
                            <!-- Portada + título -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="30" Height="30" CornerRadius="7" VerticalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xEC4F;" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock x:Name="GpMiniName" Text="" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" Width="112" />
                            </StackPanel>

                            <!-- Timeline de la canción (clic/arrastra para saltar) -->
                            <StackPanel Spacing="3">
                                <Grid x:Name="MiniSeekTrack" Height="14" Background="Transparent"
                                      PointerPressed="Seek_PointerPressed" PointerMoved="Seek_PointerMoved"
                                      PointerReleased="Seek_PointerReleased">
                                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                    <Border x:Name="MiniSeekFill" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                            HorizontalAlignment="Left" Width="0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                                <Grid>
                                    <TextBlock x:Name="MiniElapsed" Text="0:00" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="MiniTotal" Text="0:00" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Controles -->
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                <Button Click="Gp_PlayPause_Click" Background="Transparent" BorderThickness="0"
                                        Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Reproducir / pausar">
                                    <FontIcon x:Name="GpMiniPlayIcon" Glyph="&#xE769;" FontSize="15" />
                                </Button>
                                <Button Background="Transparent" BorderThickness="0"
                                        Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Volumen">
                                    <FontIcon Glyph="&#xE767;" FontSize="14" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <Slider x:Name="GpMiniVolume" Width="140" Minimum="0" Maximum="100"
                                                    ValueChanged="Gp_Volume_Changed" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Click="Gp_Cast_Click" Background="Transparent" BorderThickness="0"
                                        Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Transmitir a dispositivo">
                                    <FontIcon Glyph="&#xEC15;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </muxc:NavigationView.PaneFooter>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="Acerca de" Tag="about">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Inicio" Tag="home" IsSelected="True">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Descargas" Tag="downloads">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Descargas en cascada" Tag="cascade">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Biblioteca" Tag="library">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Editor" Tag="editor">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Organizador" Tag="organizer">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Monitor de recursos" Tag="resources">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItemSeparator />
                <muxc:NavigationViewItem Content="Experimental" Tag="experimental">
                    <muxc:NavigationViewItem.Icon>
                        <PathIcon Data="M6.5,2 H9.5 V3 H9 V6 L12.4,12.4 C12.9,13.2 12.3,14 11.5,14 H4.5 C3.7,14 3.1,13.2 3.6,12.4 L7,6 V3 H6.5 Z" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Banner de actualización (oculto por defecto) -->
                <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
                        Margin="12,8,12,0" Padding="14,10" CornerRadius="8"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE777;" FontSize="16" Foreground="White"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" x:Name="UpdateBannerText" Foreground="White"
                                   VerticalAlignment="Center" FontSize="13" />
                        <Button Grid.Column="2" Click="UpdateBanner_Action_Click"
                                Background="White" Foreground="Black" Padding="14,4" Margin="0,0,8,0">
                            <TextBlock x:Name="UpdateBannerActionText" Text="Ir a Configuración" FontWeight="SemiBold" />
                        </Button>
                        <Button Grid.Column="3" x:Name="UpdateBannerDismiss" Click="UpdateBanner_Dismiss_Click"
                                Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0"
                                ToolTipService.ToolTip="Cerrar">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="White" />
                        </Button>
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </muxc:NavigationView>

        <!-- Banner del portapapeles (oculto por defecto) -->
        <Border x:Name="ClipboardBanner" Grid.Row="2" Visibility="Collapsed"
                Margin="12,0,12,8" Padding="14,10" CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                              TintOpacity="0.5" TintLuminosityOpacity="0.9"
                              FallbackColor="{ThemeResource SolidBackgroundFillColorSecondary}" />
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE71B;" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Enlace detectado en el portapapeles" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="ClipboardUrlText" Text="" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
                <Button Grid.Column="2" Click="ClipboardBanner_Download_Click"
                        Style="{ThemeResource AccentButtonStyle}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="12" />
                        <TextBlock Text="Descargar" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Click="ClipboardBanner_Dismiss_Click"
                        Background="Transparent" BorderThickness="0"
                        Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Ignorar">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- Reproductor expandido (solo en Biblioteca) -->
        <Border x:Name="GlobalPlayer" Grid.Row="3" Visibility="Collapsed"
                Margin="12,0,12,12" Height="64" CornerRadius="14"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                              TintOpacity="0.4" TintLuminosityOpacity="0.9"
                              FallbackColor="{ThemeResource SolidBackgroundFillColorSecondary}" />
            </Border.Background>
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xEC4F;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="GpName" Text="" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="Reproduciendo" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- VU meter real (2 canales) -->
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid Height="6">
                        <Border CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                        <Border x:Name="GpVuLeftBig" CornerRadius="3" HorizontalAlignment="Left" Width="0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Grid>
                    <Grid Height="6">
                        <Border CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                        <Border x:Name="GpVuRightBig" CornerRadius="3" HorizontalAlignment="Left" Width="0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="GpPrev" Click="Gp_Prev_Click" Background="Transparent" BorderThickness="0"
                            Width="36" Height="44" Padding="0" ToolTipService.ToolTip="Anterior">
                        <FontIcon Glyph="&#xE892;" FontSize="15" />
                    </Button>
                    <Button Click="Gp_PlayPause_Click" Background="Transparent" BorderThickness="0"
                            Width="44" Height="44" Padding="0" ToolTipService.ToolTip="Reproducir / pausar">
                        <FontIcon x:Name="GpPlayIcon" Glyph="&#xE769;" FontSize="18" />
                    </Button>
                    <Button x:Name="GpNext" Click="Gp_Next_Click" Background="Transparent" BorderThickness="0"
                            Width="36" Height="44" Padding="0" ToolTipService.ToolTip="Siguiente">
                        <FontIcon Glyph="&#xE893;" FontSize="15" />
                    </Button>
                </StackPanel>

                <FontIcon Grid.Column="4" Glyph="&#xE767;" FontSize="14" Margin="10,0,6,0"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Slider Grid.Column="5" x:Name="GpVolume" Width="110" Minimum="0" Maximum="100"
                        VerticalAlignment="Center" ValueChanged="Gp_Volume_Changed" />

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <!-- Letra sincronizada (karaoke) -->
                    <Button Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0"
                            ToolTipService.ToolTip="Letra sincronizada">
                        <FontIcon Glyph="&#xE7F0;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout Placement="Top" Opened="Lyrics_FlyoutOpened" Closed="Lyrics_FlyoutClosed">
                                <Grid Width="360" MaxHeight="500" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="LyricsTitle" Text="Letra" FontWeight="SemiBold" FontSize="15"
                                               TextTrimming="CharacterEllipsis" />
                                    <ListView Grid.Row="1" x:Name="LyricsList" SelectionMode="None" IsItemClickEnabled="False">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="8,3" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="core:LyricLineVm">
                                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="14"
                                                           Foreground="{Binding IsCurrent, Mode=OneWay, Converter={StaticResource LyricBrush}}"
                                                           FontWeight="{Binding IsCurrent, Mode=OneWay, Converter={StaticResource LyricWeight}}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock Grid.Row="1" x:Name="LyricsEmpty" Visibility="Collapsed"
                                               VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Buscando letra…" />
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Cola de reproducción -->
                    <Button Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0"
                            ToolTipService.ToolTip="Cola de reproducción">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout Placement="Top" Opened="Queue_FlyoutOpened">
                                <Grid Width="330" MaxHeight="440" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Cola de reproducción" FontWeight="SemiBold" FontSize="14" />
                                    <ListView Grid.Row="1" x:Name="QueueList"
                                              SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Queue_ItemClick"
                                              CanReorderItems="True" AllowDrop="True" ReorderMode="Enabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="8,4" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="core:QueueItem">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE76F;" FontSize="11" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Click="QueueRemove_Click" Tag="{x:Bind}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Width="28" Height="28" Padding="0"
                                                            ToolTipService.ToolTip="Quitar de la cola">
                                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Click="Gp_Cast_Click" Background="Transparent" BorderThickness="0"
                            Width="40" Height="40" Padding="0" ToolTipService.ToolTip="Transmitir a dispositivo">
                        <FontIcon Glyph="&#xEC15;" FontSize="14" />
                    </Button>
                    <Button Click="Gp_PopOut_Click" Background="Transparent" BorderThickness="0"
                            Width="40" Height="40" Padding="0" ToolTipService.ToolTip="Mini-reproductor flotante">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    </Button>
                    <Button Click="Gp_Close_Click" Background="Transparent" BorderThickness="0"
                            Width="40" Height="40" Padding="0" ToolTipService.ToolTip="Cerrar">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

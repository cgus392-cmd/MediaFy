<Window x:Class="YTDownloader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:YTDownloader.Models"
        Title="YT Downloader"
        Height="720" Width="960"
        MinHeight="580" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Colores base -->
        <Color x:Key="SurfaceColor">#18FFFFFF</Color>
        <Color x:Key="SurfaceHoverColor">#28FFFFFF</Color>
        <Color x:Key="BorderColor">#20FFFFFF</Color>
        <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
        <Color x:Key="TextSecondaryColor">#AAFFFFFF</Color>
        <Color x:Key="TextTertiaryColor">#66FFFFFF</Color>
        <Color x:Key="AccentColor">#FF0078D4</Color>

        <SolidColorBrush x:Key="SurfaceBrush"     Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="BorderBrush_"     Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="TextPrimary"      Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondary"    Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextTertiary"     Color="{StaticResource TextTertiaryColor}" />
        <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}" />

        <!-- Botón sutil (icono) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background"   Value="Transparent" />
            <Setter Property="BorderBrush"  Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground"   Value="{StaticResource TextPrimary}" />
            <Setter Property="Width"  Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón acento (Descargar) -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background"   Value="#FF0078D4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground"   Value="White" />
            <Setter Property="FontSize"     Value="13" />
            <Setter Property="FontWeight"   Value="SemiBold" />
            <Setter Property="Cursor"       Value="Hand" />
            <Setter Property="Padding"      Value="20,0" />
            <Setter Property="Height"       Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF1A86D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF006CBD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox limpio -->
        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background"   Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground"   Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush"   Value="White" />
            <Setter Property="FontSize"     Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding"      Value="4,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox estilo Windows 11 -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"   Value="#18FFFFFF" />
            <Setter Property="BorderBrush"  Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground"   Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding"      Value="10,6" />
            <Setter Property="Height"       Value="36" />
            <Setter Property="Cursor"       Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="&#xE70D;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="11" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Grid>
                            </Border>
                            <ToggleButton Opacity="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom">
                                <Border Background="#FF2D2D2D" BorderBrush="#40FFFFFF"
                                        BorderThickness="1" CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="Black" />
                                    </Border.Effect>
                                    <ItemsPresenter Margin="4" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding"    Value="10,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bg" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar estilo Windows 11 -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="Foreground" Value="#FF0078D4" />
            <Setter Property="Height"     Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2" Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Track" CornerRadius="2"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Track" Property="Width" Value="40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar invisible (scroll suave) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"  Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border CornerRadius="3" Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#40FFFFFF" Margin="1,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fondo semi-transparente sobre Mica -->
    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />  <!-- Title bar -->
                <RowDefinition Height="Auto" /><!-- URL -->
                <RowDefinition Height="Auto" /><!-- Options -->
                <RowDefinition Height="*" />   <!-- List -->
                <RowDefinition Height="Auto" /><!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══ Title Bar ══ -->
            <Grid Grid.Row="0" Background="Transparent">
                <!-- Drag area -->
                <Border x:Name="DragArea" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseMove="TitleBar_MouseMove" />

                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        <TextBlock Text="&#xEBD3;" FontFamily="Segoe Fluent Icons"
                                   FontSize="16" Foreground="#FF0078D4"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="YT Downloader" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Abrir carpeta" Click="BtnOpenFolder_Click">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Configuración" Click="BtnSettings_Click">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Button>

                        <!-- Botones de ventana -->
                        <Button Style="{StaticResource IconButton}" Width="46"
                                Click="BtnMinimize_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Button>
                        <Button x:Name="BtnMaxRestore" Style="{StaticResource IconButton}" Width="46"
                                Click="BtnMaximize_Click">
                            <TextBlock x:Name="MaxIcon" Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="46"
                                Click="BtnClose_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                       Foreground="{StaticResource TextSecondary}" />
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="0" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#B22418" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ══ URL Input ══ -->
            <Border Grid.Row="1" Margin="24,8,24,0"
                    Background="#18FFFFFF"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE71B;" FontFamily="Segoe Fluent Icons"
                               FontSize="15" Margin="14,0,8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiary}" />
                    <TextBox Grid.Column="1" x:Name="TxtUrl"
                             Style="{StaticResource CleanTextBox}"
                             KeyDown="TxtUrl_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <!-- Placeholder manual -->
                    <TextBlock Grid.Column="1" x:Name="TxtPlaceholder"
                               Text="Pega aquí el enlace de YouTube..."
                               FontSize="14" Foreground="{StaticResource TextTertiary}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               IsHitTestVisible="False" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            ToolTip="Pegar del portapapeles" Click="BtnPaste_Click"
                            Margin="4">
                        <TextBlock Text="&#xF0E3;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Button>
                </Grid>
            </Border>

            <!-- ══ Formato / Calidad / Descargar ══ -->
            <Grid Grid.Row="2" Margin="24,12,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="FORMATO" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiary}" Margin="2,0,0,5" />
                    <ComboBox x:Name="CboFormat" Width="115"
                              SelectionChanged="CboFormat_SelectionChanged">
                        <ComboBoxItem Content="MP4" IsSelected="True" />
                        <ComboBoxItem Content="MP3" />
                        <ComboBoxItem Content="M4A" />
                        <ComboBoxItem Content="WEBM" />
                        <ComboBoxItem Content="OGG" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="CALIDAD" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiary}" Margin="2,0,0,5" />
                    <ComboBox x:Name="CboQuality" Width="130">
                        <ComboBoxItem Content="Mejor" IsSelected="True" />
                        <ComboBoxItem Content="4K" />
                        <ComboBoxItem Content="1080p" />
                        <ComboBoxItem Content="720p" />
                        <ComboBoxItem Content="480p" />
                        <ComboBoxItem Content="360p" />
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="4" x:Name="BtnDownload"
                        Style="{StaticResource AccentButton}"
                        MinWidth="150" VerticalAlignment="Bottom"
                        Click="BtnDownload_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons"
                                   FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Descargar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ══ Lista de descargas ══ -->
            <Grid Grid.Row="3" Margin="24,20,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Descargas" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <Border Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="9,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCount" Text="0" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}"
                            Width="Auto" Padding="12,0" Click="BtnClearDone_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons"
                                       FontSize="13" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="Limpiar completadas" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Estado vacío -->
                <StackPanel Grid.Row="1" x:Name="EmptyState"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="52"
                               Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sin descargas todavía" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Text="Pega un enlace de YouTube arriba para comenzar"
                               FontSize="13" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextTertiary}" />
                </StackPanel>

                <!-- Items -->
                <ScrollViewer Grid.Row="1" x:Name="DownloadScroll"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="DownloadsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DownloadItem}">
                                <Border Margin="0,0,0,8" CornerRadius="10"
                                        Background="#18FFFFFF"
                                        BorderBrush="#20FFFFFF" BorderThickness="1"
                                        Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail -->
                                        <Border Width="64" Height="42" CornerRadius="6"
                                                ClipToBounds="True" VerticalAlignment="Center"
                                                Background="#18FFFFFF">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" Margin="14,0,14,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextSecondary}">
                                                <Run Text="{Binding Format, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Quality, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Duration, Mode=OneWay}" />
                                            </TextBlock>
                                            <ProgressBar Margin="0,8,0,0"
                                                         Value="{Binding Progress}"
                                                         Minimum="0" Maximum="100"
                                                         Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>

                                        <!-- Badge -->
                                        <Border Grid.Column="2" CornerRadius="20"
                                                Padding="14,5" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#18FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Done">
                                                            <Setter Property="Background" Value="#2016C60A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Background" Value="#20E81123" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                            <Setter Property="Background" Value="#200078D4" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Converting">
                                                            <Setter Property="Background" Value="#20744DA9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                                                <Setter Property="Foreground" Value="#6CCB5F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Foreground" Value="#FF6B6B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                <Setter Property="Foreground" Value="#60CDFF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Converting">
                                                                <Setter Property="Foreground" Value="#B4A0FF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ══ Footer ══ -->
            <Border Grid.Row="4" Padding="24,10,24,14" Margin="0,10,0,0"
                    BorderThickness="0,1,0,0" BorderBrush="#18FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatus" Text="Listo" FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="yt-dlp + ffmpeg" FontSize="11"
                               Foreground="{StaticResource TextTertiary}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

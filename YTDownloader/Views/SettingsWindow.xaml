<Window x:Class="YTDownloader.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15"
                               Foreground="#FF0078D4" VerticalAlignment="Center" />
                    <TextBlock Text="Configuración" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="46" Height="32"
                        Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                                           FontSize="10" Foreground="#AAFFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20,8,20,0">

                <!-- Carpeta -->
                <Border Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Carpeta de descargas" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Dónde se guardan los archivos" FontSize="12"
                                       Foreground="#AAFFFFFF" Margin="0,2,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#18FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="6">
                                <TextBox x:Name="TxtFolder" IsReadOnly="True"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" Padding="8,6" />
                            </Border>
                            <Button Grid.Column="2" Content="Cambiar"
                                    Foreground="White" Background="#28FFFFFF"
                                    Padding="14,6" Click="BtnBrowse_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="6"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#30FFFFFF" BorderThickness="1">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- yt-dlp -->
                <Border Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="yt-dlp" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="TxtYtDlpVersion" FontSize="12"
                                       Foreground="#AAFFFFFF" Margin="0,2,0,0" Text="Comprobando..." />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Actualizar"
                                Foreground="White" Background="#28FFFFFF"
                                Padding="14,6" Click="BtnUpdateYtDlp_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="6"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#30FFFFFF" BorderThickness="1">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer buttons -->
            <Border Grid.Row="2" Padding="20,12,20,16" BorderThickness="0,1,0,0" BorderBrush="#18FFFFFF">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Foreground="White" Background="#18FFFFFF"
                            Padding="18,8" Margin="0,0,8,0" Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="6"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#28FFFFFF" BorderThickness="1">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Guardar" Foreground="White" Background="#FF0078D4"
                            Padding="18,8" Click="BtnSave_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#FF1A86D8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
